python3 - <<'PY'
import os, requests, pathlib

api = os.environ["RENDER_API_KEY"]
service = os.environ["SERVICE_ID"]
env_path = pathlib.Path.home() / "cashcash_cloud_worker" / "render.env"

pairs = []
for line in env_path.read_text().splitlines():
    line = line.strip()
    if not line or line.startswith("#") or "=" not in line:
        continue
    k, v = line.split("=", 1)
    pairs.append({"key": k.strip(), "value": v.strip()})

r = requests.put(
    f"https://api.render.com/v1/services/{service}/env-vars",
    headers={"Authorization": f"Bearer {api}", "Content-Type": "application/json"},
    json=pairs
)

print(r.status_code)
print(r.text)
PY
